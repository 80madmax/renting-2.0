@model BO.ViewModels.TransactionCreateViewModel

@{
    ViewData["Title"] = "Create Transaction";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="SelectedUnitIds"></label>
        <select asp-for="SelectedUnitIds"
                asp-items="Model.Units"
                class="form-control select2"
                multiple="multiple"
                style="width: 100%;">
        </select>
        <span asp-validation-for="SelectedUnitIds" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PaymentId"></label>
        <select asp-for="PaymentId" asp-items="Model.Payments" class="form-control"></select>
        <span asp-validation-for="PaymentId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Year"></label>
        <select asp-for="Year" asp-items="Model.Years" class="form-control"></select>
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Month"></label>
        <select asp-for="Month" asp-items="Model.Months" class="form-control"></select>
        <span asp-validation-for="Month" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Amount"></label>
        <input name="Amount" class="form-control" value="@Model.Amount.ToString("N2", new System.Globalization.CultureInfo("bg-BG"))" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Note"></label>
        <input asp-for="Note" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Create</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Back to List</a>
    <button type="button" id="toggleTaxesBtn" class="btn btn-info mt-2">Show Taxes</button>
</form>

<div id="taxesPanel" class="card mt-3" style="display: none;">
    <div class="card-header">
        <strong>Unit Taxes Reminder</strong>
    </div>
    <div class="card-body">
        <div id="taxesPanelContent">
            Loading taxes...
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                placeholder: "Select units",
                allowClear: true
            });

            let taxesLoaded = false;

            $('#toggleTaxesBtn').on('click', function () {
                const panel = $('#taxesPanel');
                const btn = $('#toggleTaxesBtn');

                if (panel.is(':visible')) {
                    panel.slideUp();
                    btn.text('Show Taxes');
                    return;
                }

                panel.slideDown();
                btn.text('Hide Taxes');

                if (!taxesLoaded) {
                    $.ajax({
                        url: '@Url.Action("GetUnitTaxesReminder", "Transaction")', 
                        type: 'GET',
                        success: function (response) {
                            $('#taxesPanelContent').html(response);
                            taxesLoaded = true;
                        },
                        error: function () {
                            $('#taxesPanelContent').html(
                                '<div class="text-danger">Unable to load taxes reminder.</div>'
                            );
                        }
                    });
                }
            });
        });
    </script>
}