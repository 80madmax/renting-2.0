@model BO.ViewModels.UnitViewModel
@using BO.ViewModels

@{
    ViewData["Title"] = "Unit Details";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">       
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Country</dt>
        <dd class="col-sm-10">@Model.CountryName</dd>

        <dt class="col-sm-2">City</dt>
        <dd class="col-sm-10">@Model.CityName</dd>

        <dt class="col-sm-2">District</dt>
        <dd class="col-sm-10">@Model.DistrictName</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.Address</dd>

        <dt class="col-sm-2">Floor</dt>
        <dd class="col-sm-10">@Model.FloorName</dd>

        <dt class="col-sm-2">Unit Type</dt>
        <dd class="col-sm-10">@Model.UnitTypeName</dd>         

        <dt class="col-sm-2">Cost</dt>
        <dd class="col-sm-10">@Model.Cost</dd>

        <dt class="col-sm-2">Rent Price</dt>
        <dd class="col-sm-10">@Model.RentPrice</dd>

        <dt class="col-sm-2"><label asp-for="CorporateTax"></label></dt>
        <dd class="col-sm-10">@Model.CorporateTax</dd>

        <dt class="col-sm-2"><label asp-for="VatTax"></label></dt>
        <dd class="col-sm-10">@Model.VatTax</dd>

        <dt class="col-sm-2">Telegram Chat ID</dt>
        <dd class="col-sm-10">@Model.Chat</dd>

        <dt class="col-sm-2">Note</dt>
        <dd class="col-sm-10">@Model.Note</dd>

        <dt class="col-sm-2">Is Available</dt>
        <dd class="col-sm-10"><input type="checkbox" disabled @(Model.IsAvailable ? "checked" : "") /></dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<button type="button"
        class="btn btn-danger"
        data-bs-toggle="modal"
        data-bs-target="#deleteModal"
        data-entity-id="@Model.Id"
        data-entity-value="@Model.Name">
    Delete
</button>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>

@await Html.PartialAsync("_DeleteModal", new DeleteModalViewModel
{
    EntityName = "Unit",
    EntityValue = "",
    EntityId = 0,
    ActionUrl = Url.Action("Delete", "Unit")
})

<br />
<br />
<br />