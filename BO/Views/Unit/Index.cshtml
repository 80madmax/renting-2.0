@model BO.ViewModels.UnitListViewModel

@{
    ViewData["Title"] = "Units";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Unit</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table">
    <thead>
        <tr>         
            <th>@Html.DisplayNameFor(m => m.Units[0].Name)</th>
            <th>@Html.DisplayNameFor(m => m.Units[0].UnitTypeName)</th>
            <th>@Html.DisplayNameFor(m => m.Units[0].FloorName)</th>
            <th>@Html.DisplayNameFor(m => m.Units[0].Address)</th>
            <th>@Html.DisplayNameFor(m => m.Units[0].DistrictName)</th>
            <th>@Html.DisplayNameFor(m => m.Units[0].Cost)</th>
            <th>@Html.DisplayNameFor(m => m.Units[0].RentPrice)</th>
            <th>@Html.DisplayNameFor(m => m.Units[0].IsAvailable)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var unit in Model.Units)
        {
            <tr>              
                <td>@unit.Name</td>
                <td>@unit.UnitTypeName</td>
                <td>@unit.FloorName</td>
                <td>@unit.Address</td>
                <td>@unit.DistrictName</td>
                <td>@unit.Cost.ToString("N2", new System.Globalization.CultureInfo("bg-BG"))</td>
                <td>@unit.RentPrice.ToString("N2", new System.Globalization.CultureInfo("bg-BG"))</td>
                <td>
                    <input type="checkbox" disabled @(unit.IsAvailable ? "checked" : "") />
                </td>
                <td class="text-end">
                    <button type="button"
                            class="btn btn-success btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#sendTelegramModal"
                            data-unit-id="@unit.Id"
                            data-unit-name="@unit.Name">
                        Send
                    </button>
                    <a asp-action="Edit" asp-route-id="@unit.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Details" asp-route-id="@unit.Id" class="btn btn-info btn-sm">Details</a>
                    <button type="button"
                            class="btn btn-danger btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-entity-id="@unit.Id"
                            data-entity-value="@unit.Name">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    @if (Model.HasPreviousPage)
    {
        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" class="btn btn-outline-primary">Previous</a>
    }
    Page @Model.PageIndex of @Model.TotalPages
    @if (Model.HasNextPage)
    {
        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" class="btn btn-outline-primary">Next</a>
    }
</div>

<div class="modal fade" id="sendTelegramModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Send Telegram Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" asp-action="SendTelegram">
                <div class="modal-body">
                    <input type="hidden" name="unitId" id="sendUnitId" />
                    <input type="hidden" name="month" value="@DateTime.Now.Month" />
                    <input type="hidden" name="year" value="@DateTime.Now.Year" />

                    <p>
                        Are you sure you want to send a Telegram message to
                        <strong id="sendUnitName"></strong>?
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Send</button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- Include reusable delete modal -->
@await Html.PartialAsync("_DeleteModal", new BO.ViewModels.DeleteModalViewModel
{
    EntityName = "Unit",
    EntityValue = "",
    EntityId = 0,
    ActionUrl = Url.Action("Delete", "Unit")
})

<script>
    var sendModal = document.getElementById('sendTelegramModal');
    sendModal.addEventListener('show.bs.modal', function (event) {

        var button = event.relatedTarget;

        var unitId = button.getAttribute('data-unit-id');
        var unitName = button.getAttribute('data-unit-name');

        document.getElementById('sendUnitId').value = unitId;
        document.getElementById('sendUnitName').textContent = unitName;
    });
</script>


