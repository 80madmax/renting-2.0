@model BO.ViewModels.CommunalBillEditViewModel

@{
    ViewData["Title"] = "Edit Communal Bill";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="CommunalBillId" />

    <div class="form-group">
        <label asp-for="UnitId"></label>
        <select asp-for="UnitId" asp-items="Model.Units" class="form-control"></select>
        <span asp-validation-for="UnitId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CommunalExpenseId"></label>
        <select asp-for="CommunalExpenseId" asp-items="Model.CommunalExpenses" class="form-control"></select>
        <span asp-validation-for="CommunalExpenseId" class="text-danger"></span>
    </div>  

    <div class="form-group">
        <label asp-for="Month"></label>
        <select asp-for="Month" asp-items="Model.Months" class="form-control"></select>
        <span asp-validation-for="Month" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Year"></label>
        <select asp-for="Year" asp-items="Model.Years" class="form-control"></select>
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

