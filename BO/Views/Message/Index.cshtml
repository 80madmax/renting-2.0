@model BO.ViewModels.MessageListViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Messages";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary" title="Create new message">Create New Message</a>
</p>

<!-- Feedback messages -->
@await Html.PartialAsync("_FlashMessages")

<form method="get" asp-action="Index" class="mb-4">
    <div class="row">
        <div class="col-md-3">
            <label>Unit</label>
            <select name="unitId" asp-for="SelectedUnitId" asp-items="Model.Units" class="form-control">
                <option value="">-- All Units --</option>
            </select>
        </div>
      
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
       
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Unit</th>
            <th>Message</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var message in Model.Messages)
        {
            <tr>
                <td>@message.UnitName</td>
                <td>@message.Text</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@message.Id" class="btn btn-warning btn-sm"
                       title="Edit message: @message.Text"
                       aria-label="Edit message @message.Text">Edit</a>

                    <a asp-action="Details" asp-route-id="@message.Id" class="btn btn-info btn-sm"
                       title="View details for message: @message.Text"
                       aria-label="Details for message @message.Text">Details</a>

                    <button type="button"
                            class="btn btn-danger btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteSimpleModal"
                            data-entity-id="@message.Id"
                            data-entity-value="@message.Text"
                            data-unit-name="@message.UnitName"
                            data-unit-floor=""
                            data-unit-address=""
                            title="Delete message: @message.Text"
                            aria-label="Delete message @message.Text">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    @if (Model.HasPreviousPage)
    {
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           asp-route-unitId="@Model.SelectedUnitId"
           class="btn btn-outline-primary">Previous</a>
    }
    Page @Model.PageIndex of @Model.TotalPages
    @if (Model.HasNextPage)
    {
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           asp-route-unitId="@Model.SelectedUnitId"
           class="btn btn-outline-primary">Next</a>
    }
</div>

<!-- Use detailed delete modal so we can show unit context (floor/address left blank) -->
@await Html.PartialAsync("_DeleteSimpleModal", new BO.ViewModels.DeleteModalViewModel
{
    EntityName = "Message",
    EntityValue = "",
    EntityId = 0,
    ActionUrl = Url.Action("Delete", "Message")
})

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                placeholder: "Select a unit",
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}

