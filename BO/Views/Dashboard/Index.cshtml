@model BO.ViewModels.DashboardViewModel
@using System.Text.Json
@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";

    string MonthName(int month) =>
        CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetAbbreviatedMonthName(month);

    string FullMonthName(int month) =>
        CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetMonthName(month);

    // -------- Units Monthly Balances --------
    var unitRows = Model.UnitsMonthlyBalances?.UnitsMonthlyBalances
                   ?? new List<Core.ReadModels.UnitMonthlyBalance>();

    var unitsMonth = unitRows.Count > 0 ? unitRows[0].Month : DateTime.Now.Month;
    var unitsYear = unitRows.Count > 0 ? unitRows[0].Year : DateTime.Now.Year;

    var unitsTotalAmount = unitRows.Sum(x => x.Amount);
    var unitsTotalRent = unitRows.Sum(x => x.RentPrice);

    // -------- Profit per Month --------
    var monthLabels = Model.ProfitPerMonth.MonthlyProfits.Select(m => MonthName(m.Month)).ToList();
    var monthValues = Model.ProfitPerMonth.MonthlyProfits.Select(m => m.Profit).ToList();

    var monthLabelsJson = JsonSerializer.Serialize(monthLabels);
    var monthValuesJson = JsonSerializer.Serialize(monthValues);

    var monthTotal = Model.ProfitPerMonth.MonthlyProfits.Sum(x => x.Profit);

    // -------- Profit per Year --------
    var yearLabels = Model.ProfitPerYear.YearlyProfits.Select(y => y.Year.ToString()).ToList();
    var yearValues = Model.ProfitPerYear.YearlyProfits.Select(y => y.Profit).ToList();

    var yearLabelsJson = JsonSerializer.Serialize(yearLabels);
    var yearValuesJson = JsonSerializer.Serialize(yearValues);

    var yearTotal = Model.ProfitPerYear.YearlyProfits.Sum(x => x.Profit);
}



<div class="container mt-4">
    <h2 class="mb-4 fw-bold">Dashboard</h2>

    <!-- ====================== -->
    <!-- Units Monthly Balances -->
    <!-- ====================== -->
    <div class="dash-section">

        <div class="dash-section-header">
            <div>
                <h3 class="dash-section-title">Units balances</h3>
                <div class="dash-section-subtitle">
                    @FullMonthName(unitsMonth) <strong>@unitsYear</strong>
                </div>
            </div>

            <div class="text-end">
                @{
                    var performanceClass = unitsTotalAmount >= unitsTotalRent ? "text-success" : "text-danger";
                }
                <div class="kpi-box">                 
                    <div class="kpi-value @performanceClass">@unitsTotalAmount.ToString("N2")</div>
                    <div class="kpi-label">Total amount</div>
                </div>
               
                <div class="kpi-box">
                   
                    <div class="kpi-value">@unitsTotalRent.ToString("N2")</div>
                    <div class="kpi-label">Total rent</div>
                </div>
            </div>
        </div>

        @if (!unitRows.Any())
        {
            <div class="text-muted">No units found for this period.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Apartment</th>
                            <th class="text-end">Rent price</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in unitRows)
                        {
                            var amountClass = r.Amount < 0
                            ? "text-danger"
                            : (r.Amount > 0 ? "text-success" : "text-muted");

                            <tr>
                                <td class="fw-semibold">@r.Apartment</td>
                                <td class="text-end">@r.RentPrice.ToString("N2")</td>
                                <td class="text-end @amountClass">
                                    @r.Amount.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- ====================== -->
    <!-- Profit Per Month -->
    <!-- ====================== -->
    <div class="dash-section">

        <div class="dash-section-header">
            <div>
                <h3 class="dash-section-title">Profit per month</h3>
                <div class="dash-section-subtitle">
                    Current year: <strong>@Model.ProfitPerMonth.Year</strong>
                </div>
            </div>

            <div class="text-end">
                <div class="kpi-box">                
                    <div class="kpi-value">@monthTotal.ToString("N2")</div>
                    <div class="kpi-label">Total</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div style="height: 320px;">
                            <canvas id="profitPerMonthChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="mb-3">Breakdown</h5>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Month</th>
                                        <th class="text-end">Profit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in Model.ProfitPerMonth.MonthlyProfits)
                                    {
                                        <tr>
                                            <td>@MonthName(m.Month)</td>
                                            <td class="text-end">@m.Profit.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ====================== -->
    <!-- Profit Per Year -->
    <!-- ====================== -->
    <div class="dash-section">

        <div class="dash-section-header">
            <div>
                <h3 class="dash-section-title">Profit per year</h3>
                <div class="dash-section-subtitle">All years</div>
            </div>

            <div class="text-end">
                <div class="kpi-box">
                    <div class="kpi-value">@yearTotal.ToString("N2")</div>
                    <div class="kpi-label">Total</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div style="height: 320px;">
                            <canvas id="profitPerYearChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="mb-3">Breakdown</h5>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Year</th>
                                        <th class="text-end">Profit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var y in Model.ProfitPerYear.YearlyProfits)
                                    {
                                        <tr>
                                            <td>@y.Year</td>
                                            <td class="text-end">@y.Profit.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const monthLabels = @Html.Raw(monthLabelsJson);
        const monthValues = @Html.Raw(monthValuesJson);

        const yearLabels  = @Html.Raw(yearLabelsJson);
        const yearValues  = @Html.Raw(yearValuesJson);

        const ctxMonth = document.getElementById('profitPerMonthChart');
        if (ctxMonth) {
            new Chart(ctxMonth, {
                type: 'bar',
                data: {
                    labels: monthLabels,
                    datasets: [{ data: monthValues }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { ticks: { callback: v => Number(v).toLocaleString() } }
                    }
                }
            });
        }

        const ctxYear = document.getElementById('profitPerYearChart');
        if (ctxYear) {
            new Chart(ctxYear, {
                type: 'bar',
                data: {
                    labels: yearLabels,
                    datasets: [{ data: yearValues }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { ticks: { callback: v => Number(v).toLocaleString() } }
                    }
                }
            });
        }
    </script>
}
