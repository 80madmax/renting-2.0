@model BO.ViewModels.DashboardViewModel
@using System.Text.Json
@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";

    string MonthName(int month) =>
        CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetAbbreviatedMonthName(month);

    // ---- Month tile data ----
    var monthLabels = Model.ProfitPerMonth.MonthlyProfits.Select(m => MonthName(m.Month)).ToList();
    var monthValues = Model.ProfitPerMonth.MonthlyProfits.Select(m => m.Profit).ToList();

    var monthLabelsJson = JsonSerializer.Serialize(monthLabels);
    var monthValuesJson = JsonSerializer.Serialize(monthValues);

    var monthTotal = Model.ProfitPerMonth.MonthlyProfits.Sum(x => x.Profit);

    // ---- Year tile data ----
    var yearLabels = Model.ProfitPerYear.YearlyProfits.Select(y => y.Year.ToString()).ToList();
    var yearValues = Model.ProfitPerYear.YearlyProfits.Select(y => y.Profit).ToList();

    var yearLabelsJson = JsonSerializer.Serialize(yearLabels);
    var yearValuesJson = JsonSerializer.Serialize(yearValues);

    var yearTotal = Model.ProfitPerYear.YearlyProfits.Sum(x => x.Profit);
}

<div class="container mt-4">
    <h2 class="mb-3">Dashboard</h2>

    <!-- Row 1: Profit per month -->
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <h4 class="mb-1">Profit per month</h4>
                            <div class="text-muted">Current year: <strong>@Model.ProfitPerMonth.Year</strong></div>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small">Total</div>
                            <div class="fs-4 fw-semibold">@monthTotal.ToString("N2")</div>
                        </div>
                    </div>

                    <hr class="my-3" />

                    <div style="height: 320px;">
                        <canvas id="profitPerMonthChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="mb-3">Breakdown</h5>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Month</th>
                                    <th class="text-end">Profit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.ProfitPerMonth.MonthlyProfits)
                                {
                                    <tr>
                                        <td>@MonthName(m.Month)</td>
                                        <td class="text-end">@m.Profit.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Profit per year -->
    <div class="row g-4 mt-1">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <h4 class="mb-1">Profit per year</h4>
                            <div class="text-muted">All years</div>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small">Total</div>
                            <div class="fs-4 fw-semibold">@yearTotal.ToString("N2")</div>
                        </div>
                    </div>

                    <hr class="my-3" />

                    <div style="height: 320px;">
                        <canvas id="profitPerYearChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="mb-3">Breakdown</h5>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Year</th>
                                    <th class="text-end">Profit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var y in Model.ProfitPerYear.YearlyProfits)
                                {
                                    <tr>
                                        <td>@y.Year</td>
                                        <td class="text-end">@y.Profit.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const monthLabels = @Html.Raw(monthLabelsJson);
        const monthValues = @Html.Raw(monthValuesJson);

        const yearLabels  = @Html.Raw(yearLabelsJson);
        const yearValues  = @Html.Raw(yearValuesJson);

        const ctxMonth = document.getElementById('profitPerMonthChart');
        if (ctxMonth) {
            new Chart(ctxMonth, {
                type: 'bar',
                data: {
                    labels: monthLabels,
                    datasets: [{ label: 'Profit', data: monthValues, borderWidth: 1 }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            ticks: {
                                callback: (v) => Number(v).toLocaleString()
                            }
                        }
                    }
                }
            });
        }

        const ctxYear = document.getElementById('profitPerYearChart');
        if (ctxYear) {
            new Chart(ctxYear, {
                type: 'bar',
                data: {
                    labels: yearLabels,
                    datasets: [{ label: 'Profit', data: yearValues, borderWidth: 1 }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            ticks: {
                                callback: (v) => Number(v).toLocaleString()
                            }
                        }
                    }
                }
            });
        }
    </script>
}
