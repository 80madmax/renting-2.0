@model BO.ViewModels.DeleteModalViewModel

<div class="modal fade" id="deleteSimpleModal" tabindex="-1" aria-labelledby="deleteSimpleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteSimpleForm" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Delete @Model.EntityName</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong id="simpleEntityValue">@Model.EntityValue</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        const modal = document.getElementById('deleteSimpleModal');
        if (!modal) return;

        modal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const entityId = button.getAttribute('data-entity-id');
            const entityValue = button.getAttribute('data-entity-value') || '';

            const form = modal.querySelector('#deleteSimpleForm');
            const valueDisplay = modal.querySelector('#simpleEntityValue');

            valueDisplay.textContent = entityValue;

            var base = '@Model.ActionUrl';
            if (base.endsWith('/')) base = base.slice(0, -1);
            form.action = base + '/' + entityId;
        });
    })();
</script>