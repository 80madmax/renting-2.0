@using System
@using System.Linq
@using System.Security.Claims
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery AntiForgery

@functions {
    // Helper used by navigation links to mark active controller(s)
    private bool isActiveController(params string[] controllers)
    {
        var routeData = Context?.GetRouteData();
        var current = (routeData?.Values["controller"] as string) ?? string.Empty;
        return controllers.Any(c => string.Equals(current, c, StringComparison.OrdinalIgnoreCase));
    }
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Renting</title>

    <!-- Bootstrap CSS (local via LibMan) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BO.styles.css" asp-append-version="true" />

    <!-- Select2 CSS via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
</head>
<body>      
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">Renting</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    @* MAIN NAVIGATION: menus + submenus *@
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">

                        <li class="nav-item">
                            <a class="nav-link @(isActiveController("Dashboard") ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(isActiveController("Transaction") ? "active" : "")"
                               asp-controller="Transaction" asp-action="Index">Transactions</a>
                        </li>

                        @* Reports with submenus: Expenses & Incomes, Taxes *@
                        @{
                            var reportsActive = isActiveController("Reports", "ExpensesIncome", "TaxesReport");
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(reportsActive ? "active" : "")"
                               href="#" id="reportsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Reports
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="reportsDropdown">
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="ExpensesIncome">Expenses &amp; Incomes</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="TaxesReport">Taxes</a></li>
                            </ul>
                        </li>

                        @* Reminders with sub items: Communal Bills, Messages *@
                        @{
                            var remindersActive = isActiveController("CommunalBill", "Message");
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(remindersActive ? "active" : "")"
                               href="#" id="remindersDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Reminders
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="remindersDropdown">
                                <li><a class="dropdown-item" asp-controller="CommunalBill" asp-action="Index">Communal Bills</a></li>
                                <li><a class="dropdown-item" asp-controller="Message" asp-action="Index">Messages</a></li>
                            </ul>
                        </li>

                        @* Settings - Units, Countries, Cities, Districts, Payments, Roles, Users *@
                        @{
                            var settingsActive = isActiveController("Unit", "Country", "City", "District", "Payment", "Role", "User", "PaymentType", "UnitType", "Floor");
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(settingsActive ? "active" : "")"
                               href="#" id="settingsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Settings
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="settingsDropdown">
                                <li><a class="dropdown-item" asp-controller="Unit" asp-action="Index">Units</a></li>
                                <li><a class="dropdown-item" asp-controller="Country" asp-action="Index">Countries</a></li>
                                <li><a class="dropdown-item" asp-controller="City" asp-action="Index">Cities</a></li>
                                <li><a class="dropdown-item" asp-controller="District" asp-action="Index">Districts</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="Index">Payments</a></li>
                                @* Roles & Users links visible only to Super Admin *@
                                @if (User?.IsInRole("Super Admin") == true)
                                {
                                    <li><a class="dropdown-item" asp-controller="Role" asp-action="Index">Roles</a></li>
                                    <li><a class="dropdown-item" asp-controller="User" asp-action="Index">Users</a></li>
                                }
                            </ul>
                        </li>

                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                            var role = User.FindFirst(ClaimTypes.Role)?.Value;
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity?.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li class="dropdown-item-text">
                                        <small class="text-muted">Role: @(!string.IsNullOrEmpty(role) ? role : "—")</small>
                                    </li>
                                    <li><a class="dropdown-item" asp-controller="User" asp-action="Details" asp-route-id="@userId">Profile</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-3">
        @RenderBody()
    </div>

    <footer class="footer mt-auto py-3 bg-light">
        <div class="container">
            <span class="text-muted">&copy; @(DateTime.Now.Year) Renting</span>
        </div>
    </footer>

    <!-- jQuery (local) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap Bundle (local) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Select2 JS (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- jQuery Validation (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.13/dist/jquery.validate.unobtrusive.min.js"></script>

    <!-- Custom Decimal Validation for bg-BG -->
    <script>
        jQuery.validator.methods.number = function (value, element) {
            value = value.replace(",", ".");
            return this.optional(element) || !isNaN(value);
        };
    </script>

    <!-- Site scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
