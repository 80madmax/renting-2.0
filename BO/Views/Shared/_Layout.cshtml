@using System
@using System.Linq
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BO</title>

    <!-- Bootstrap CSS (local via LibMan) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BO.styles.css" asp-append-version="true" />

    <!-- Select2 CSS via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
</head>
<body>
    <header>
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

            var isActiveController = new Func<string, bool>(c => string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase));
            var isActive = new Func<string, string, bool>((c, a) => isActiveController(c) && string.Equals(a, currentAction, StringComparison.OrdinalIgnoreCase));
            var isActiveAny = new Func<string[], bool>(arr => arr.Any(a => string.Equals(a, currentController, StringComparison.OrdinalIgnoreCase)));
        }

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BO</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        <li class="nav-item">
                            <a class="nav-link @(isActiveController("Dashboard") ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(isActiveController("Transaction") ? "active" : "")"
                               asp-controller="Transaction" asp-action="Index">Transactions</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(isActiveController("Reports") ? "active" : "")"
                               href="#"
                               id="reportsDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Reports
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="reportsDropdown">
                                <li>
                                    <a class="dropdown-item @(isActive("Reports", "ExpensesIncome") ? "active" : "")"
                                       asp-controller="Reports" asp-action="ExpensesIncome">Expenses / Income</a>
                                </li>
                                <li>
                                    <a class="dropdown-item @(isActive("Reports", "TaxesReport") ? "active" : "")"
                                       asp-controller="Reports" asp-action="TaxesReport">Taxes</a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(isActiveAny(new[] { "Message", "CommunalBills" }) ? "active" : "")"
                               href="#"
                               id="remindersDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Reminders
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="remindersDropdown">
                                <li>
                                    @* Use the same tag-helper approach as Settings so URLs are generated correctly (absolute) *@
                                    <a class="dropdown-item @(isActiveController("CommunalBill") ? "active" : "")"
                                       asp-controller="CommunalBill" asp-action="Index">Communal Bills</a>
                                </li>
                                <li>
                                    <a class="dropdown-item @(isActiveController("Message") ? "active" : "")"
                                       asp-controller="Message" asp-action="Index">Messages</a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(isActiveAny(new[] { "Unit", "Country", "City", "District", "Payment", "Role", "User" }) ? "active" : "")"
                               href="#"
                               id="settingsDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Settings
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="settingsDropdown">
                                <li><a class="dropdown-item @(isActiveController("Unit") ? "active" : "")" asp-controller="Unit" asp-action="Index">Units</a></li>
                                <li><a class="dropdown-item @(isActiveController("Country") ? "active" : "")" asp-controller="Country" asp-action="Index">Countries</a></li>
                                <li><a class="dropdown-item @(isActiveController("City") ? "active" : "")" asp-controller="City" asp-action="Index">Cities</a></li>
                                <li><a class="dropdown-item @(isActiveController("District") ? "active" : "")" asp-controller="District" asp-action="Index">Districts</a></li>
                                <li><a class="dropdown-item @(isActiveController("Payment") ? "active" : "")" asp-controller="Payment" asp-action="Index">Payments</a></li>
                                <li><a class="dropdown-item @(isActiveController("Role") ? "active" : "")" asp-controller="Role" asp-action="Index">Roles</a></li>
                                <li><a class="dropdown-item @(isActiveController("User") ? "active" : "")" asp-controller="User" asp-action="Index">Users</a></li>
                            </ul>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark @(isActiveController("Home") ? "active" : "")" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        @* Authentication/account placeholders - replace with actual implementation later *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="#">Account</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - BO - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- jQuery (local) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap Bundle (local) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Select2 JS (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- jQuery Validation (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.13/dist/jquery.validate.unobtrusive.min.js"></script>

    <!-- Custom Decimal Validation for bg-BG -->
    <script>
        jQuery.validator.methods.number = function (value, element) {
            value = value.replace(",", ".");
            return this.optional(element) || !isNaN(value);
        };
    </script>

    <!-- Site scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
