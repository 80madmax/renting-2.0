@model BO.ViewModels.DistrictListViewModel

@{
    ViewData["Title"] = "Districts";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New District</a>
</p>

@await Html.PartialAsync("_FlashMessages")

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Districts[0].Name)</th>
            <th>@Html.DisplayNameFor(m => m.Districts[0].CityName)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Districts)
        {
            <tr>
                <td>@d.Name</td>
                <td>@d.CityName</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-info btn-sm">Details</a>
                    <button type="button"
                            class="btn btn-danger btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteSimpleModal"
                            data-entity-id="@d.Id"
                            data-entity-value="@d.Name">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    @if (Model.HasPreviousPage)
    {
        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" class="btn btn-outline-primary">Previous</a>
    }
    Page @Model.PageIndex of @Model.TotalPages
    @if (Model.HasNextPage)
    {
        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" class="btn btn-outline-primary">Next</a>
    }
</div>

@await Html.PartialAsync("_DeleteSimpleModal", new BO.ViewModels.DeleteModalViewModel
{
    EntityName = "District",
    EntityValue = "", // placeholder; JS sets it dynamically
    EntityId = 0,     // placeholder; JS sets it dynamically
    ActionUrl = Url.Action("Delete", "District")
})